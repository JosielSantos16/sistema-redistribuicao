<center style="width: 100%; background-color: #f3f2ef;">
  <table
      align="center"
      border="0"
      cellpadding="0"
      cellspacing="0"
      width="100%"
      style="background-color: #f3f2ef; margin: 0 auto;"
    >
      <tr>
        <td align="center" style="padding: 40px 0;">

          <table
            align="center"
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="600"
            style="background-color: #ffffff; border-radius: 8px; border: 1px solid #e0e0e0; border-collapse: separate;"
          >
            <tr>
              <td align="center" style="padding: 40px;">

                <table border="0" cellpadding="0" cellspacing="0" width="100%">
                  <tr>
                    <td align="center" style="padding-bottom: 30px;">
                      <h1
                        style="margin: 0; color: #001858; font-size: 32px; font-family: Arial, sans-serif; font-weight: 800;"
                      >
                        WOLF</h1>
                    </td>
                  </tr>
                </table>

                <table border="0" cellpadding="0" cellspacing="0">
                  <tr>
                    <td align="center" style="padding-bottom: 20px;">
                      <div
                        style="width: 70px; height: 70px; background-color: #e6fff2; border-radius: 50%; line-height: 70px; color: #16a34a; font-size: 30px; font-family: Arial, sans-serif;"
                      >
                        ✓
                      </div>
                    </td>
                  </tr>
                </table>

                <table border="0" cellpadding="0" cellspacing="0" width="100%">
                  <tr>
                    <td align="center">
                      <h2
                        style="margin: 0 0 15px 0; color: #333333; font-size: 24px; font-family: Arial, sans-serif; font-weight: 600;"
                      >
                        Parabéns, {{nome}}! Deu match.</h2>
                      <p
                        style="margin: 0 0 20px 0; color: #666666; font-size: 16px; font-family: Arial, sans-serif; line-height: 1.6;"
                      >
                        Você e <strong>{{outroNome}}</strong> confirmaram interesse
                        mútuo. Agora vocês já podem entrar em contato diretamente.
                      </p>
                      <p
                        style="margin: 0 0 30px 0; padding: 14px 20px; background-color: #f8fafc; border-radius: 8px; color: #001858; font-size: 15px; font-family: Arial, sans-serif; font-weight: 600;"
                      >
                        E-mail de contato: {{outroEmail}}
                      </p>
                    </td>
                  </tr>
                </table>

                <table
                  align="center"
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                  style="margin: 20px auto;"
                >
                  <tr>
                    <td
                      align="center"
                      bgcolor="#FF6600"
                      style="border-radius: 50px; padding: 15px 40px;"
                    >
                      <a
                        href="http://localhost:3000/notificacoes"
                        target="_blank"
                        style="color: #ffffff; font-family: Arial, sans-serif; font-size: 16px; font-weight: bold; text-decoration: none; display: block; min-width: 200px;"
                      >
                        Ver no sistema
                      </a>
                    </td>
                  </tr>
                </table>

              </td>
            </tr>
          </table>

          <table align="center" border="0" cellpadding="0" cellspacing="0" width="600">
            <tr>
              <td
                align="center"
                style="padding: 25px 0; font-family: Arial, sans-serif; font-size: 12px; color: #888888; line-height: 1.5;"
              >
                Este é um e-mail automático do
                <strong>Sistema WOLF - UFOPA</strong>.
              </td>
            </tr>
          </table>

        </td>
      </tr>
    </table>
    </center>