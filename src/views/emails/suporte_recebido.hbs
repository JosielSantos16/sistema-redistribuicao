<center style="width: 100%; background-color: #f3f2ef;">
  <table
      align="center"
      border="0"
      cellpadding="0"
      cellspacing="0"
      width="100%"
      style="background-color: #f3f2ef; margin: 0 auto;"
    >
      <tr>
        <td align="center" style="padding: 40px 0;">

          <table
            align="center"
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="600"
            style="background-color: #ffffff; border-radius: 8px; border: 1px solid #e0e0e0; border-collapse: separate;"
          >
            <tr>
              <td align="center" style="padding: 40px;">

                <table border="0" cellpadding="0" cellspacing="0" width="100%">
                  <tr>
                    <td align="center" style="padding-bottom: 30px;">
                      <h1
                        style="margin: 0; color: #001858; font-size: 32px; font-family: Arial, sans-serif; font-weight: 800;"
                      >
                        WOLF</h1>
                    </td>
                  </tr>
                </table>

                <table border="0" cellpadding="0" cellspacing="0" width="100%">
                  <tr>
                    <td align="left">
                      <h2
                        style="margin: 0 0 20px 0; color: #333333; font-size: 22px; font-family: Arial, sans-serif; font-weight: 600;"
                      >
                        Nova mensagem de suporte</h2>

                      <p style="margin: 0 0 8px 0; color: #333333; font-size: 14px; font-family: Arial, sans-serif;">
                        <strong>Nome:</strong> {{nome}}
                      </p>
                      <p style="margin: 0 0 8px 0; color: #333333; font-size: 14px; font-family: Arial, sans-serif;">
                        <strong>E-mail:</strong> {{email}}
                      </p>
                      <p style="margin: 0 0 20px 0; color: #333333; font-size: 14px; font-family: Arial, sans-serif;">
                        <strong>Telefone:</strong> {{telefone}}
                      </p>

                      <p
                        style="margin: 0; padding: 16px; background-color: #f8fafc; border-radius: 8px; color: #444444; font-size: 14px; font-family: Arial, sans-serif; line-height: 1.6; white-space: pre-wrap;"
                      >{{mensagem}}</p>
                    </td>
                  </tr>
                </table>

              </td>
            </tr>
          </table>

          <table align="center" border="0" cellpadding="0" cellspacing="0" width="600">
            <tr>
              <td
                align="center"
                style="padding: 25px 0; font-family: Arial, sans-serif; font-size: 12px; color: #888888; line-height: 1.5;"
              >
                Este é um e-mail automático do
                <strong>Sistema WOLF - UFOPA</strong>.
              </td>
            </tr>
          </table>

        </td>
      </tr>
    </table>
    </center>