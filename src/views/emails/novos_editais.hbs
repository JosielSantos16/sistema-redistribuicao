<center style="width: 100%; background-color: #f3f2ef;">
  <table
      align="center"
      border="0"
      cellpadding="0"
      cellspacing="0"
      width="100%"
      style="background-color: #f3f2ef; margin: 0 auto;"
    >
      <tr>
        <td align="center" style="padding: 40px 0;">

          <table
            align="center"
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="600"
            style="background-color: #ffffff; border-radius: 8px; border: 1px solid #e0e0e0; border-collapse: separate;"
          >
            <tr>
              <td align="center" style="padding: 40px;">

                <table border="0" cellpadding="0" cellspacing="0" width="100%">
                  <tr>
                    <td align="center" style="padding-bottom: 30px;">
                      <h1
                        style="margin: 0; color: #001858; font-size: 32px; font-family: Arial, sans-serif; font-weight: 800;"
                      >
                        WOLF</h1>
                    </td>
                  </tr>
                </table>

                <table border="0" cellpadding="0" cellspacing="0" width="100%">
                  <tr>
                    <td align="left">
                      <h2
                        style="margin: 0 0 10px 0; color: #333333; font-size: 22px; font-family: Arial, sans-serif; font-weight: 600;"
                      >
                        Olá, {{nome}}!</h2>
                      <p
                        style="margin: 0 0 24px 0; color: #666666; font-size: 15px; font-family: Arial, sans-serif; line-height: 1.6;"
                      >
                        Nosso robô encontrou novos editais que combinam com seu
                        estado de destino ou instituição:
                      </p>
                    </td>
                  </tr>
                </table>

                {{#each editais}}
                <table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-bottom: 14px;">
                  <tr>
                    <td
                      style="padding: 16px; background-color: #f8fafc; border-radius: 8px; border-left: 3px solid #FF6600;"
                    >
                      <p style="margin: 0 0 6px 0; color: #001858; font-size: 14px; font-family: Arial, sans-serif; font-weight: 700;">
                        {{this.instituicao}} — {{this.titulo}}
                      </p>
                      <a
                        href="{{this.url_documento}}"
                        target="_blank"
                        style="color: #FF6600; font-size: 13px; font-family: Arial, sans-serif; text-decoration: none;"
                      >
                        Acessar edital →
                      </a>
                    </td>
                  </tr>
                </table>
                {{/each}}

                <table
                  align="center"
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                  style="margin: 24px auto 0;"
                >
                  <tr>
                    <td
                      align="center"
                      bgcolor="#001858"
                      style="border-radius: 50px; padding: 14px 36px;"
                    >
                      <a
                        href="http://localhost:3000/editais"
                        target="_blank"
                        style="color: #ffffff; font-family: Arial, sans-serif; font-size: 14px; font-weight: bold; text-decoration: none; display: block;"
                      >
                        Ver todos os editais
                      </a>
                    </td>
                  </tr>
                </table>

              </td>
            </tr>
          </table>

          <table align="center" border="0" cellpadding="0" cellspacing="0" width="600">
            <tr>
              <td
                align="center"
                style="padding: 25px 0; font-family: Arial, sans-serif; font-size: 12px; color: #888888; line-height: 1.5;"
              >
                Este é um e-mail automático do
                <strong>Sistema WOLF - UFOPA</strong>. Você pode desligar esse
                aviso em Configurações.
              </td>
            </tr>
          </table>

        </td>
      </tr>
    </table>
    </center>